<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" >

    <xacro:include filename="inertial_macros.xacro"/>

    <xacro:property name="chassis_length" value="0.3"/>
    <xacro:property name="chassis_width" value="0.2"/>
    <xacro:property name="chassis_height" value="0.05"/>
    <xacro:property name="chassis_mass" value="5.0"/>
    
    <xacro:property name="rocker_length" value="0.13"/>
    <xacro:property name="rocker_width" value="0.02"/>
    <xacro:property name="rocker_height" value="0.2"/>
    <xacro:property name="tilted_link" value="0.1"/>
    <xacro:property name="rocker_mass" value="0.5"/>
    <xacro:property name="wheel_radius" value="0.0375"/>  <!-- 75 mm spiked wheels (2026-10-25); was 0.0239 -->
    <xacro:property name="wheel_thickness" value="0.026"/>
    <xacro:property name="wheel_mass" value="0.05"/>

    <material name="orange">
        <color rgba="1 0.3 0.1 1"/>
    </material>
    <material name="blue">
        <color rgba="0.2 0.2 1 1"/>
    </material>
    <material name="black">
        <color rgba="0 0 0 1"/>
    </material>

    <link name="base_footprint"/>

    <joint name="base_footprint_joint" type="fixed">
        <parent link="base_footprint"/>
        <child link="base_link"/>
        <origin xyz="0 0 0.1082" rpy="0 0 0"/>  <!-- was 0.0946; +0.0136 m for the bigger wheels (0.0375 - 0.0239) -->
    </joint>

    <link name="base_link">
    </link>

    <joint name="chassis_joint" type="fixed">
        <parent link="base_link"/>
        <child link="chassis"/>
        <!-- base_link sits on the WHEEL AXLE (the rotation centre of a diff drive). It used to be the rear edge of the chassis,
             0.15 m behind the axle, which made odometry, SLAM, AMCL and Nav2 footprint checks all assume the wrong pivot. -->
        <origin xyz="${-chassis_length/2} 0 0"/>
    </joint>

    <link name="chassis">
        <visual>
            <origin xyz="${chassis_length/2} 0 ${chassis_height/2}"/>
            <geometry>
                <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
            </geometry>
            <material name="orange"/>
        </visual>
        <collision>
            <origin xyz="${chassis_length/2} 0 ${chassis_height/2}"/>
            <geometry>
                <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
            </geometry>
        </collision>
        <xacro:inertial_box mass="${chassis_mass}" x="${chassis_length}" y="${chassis_width}" z="${chassis_height}">
            <origin xyz="${chassis_length/2} 0 ${chassis_height/2}" rpy="0 0 0"/>
        </xacro:inertial_box>
    </link>

    <gazebo reference="chassis">
        <material>Gazebo/Orange</material>
    </gazebo>

    <!-- Rocker-to-chassis pivot. TEMPORARILY fixed (rigid) while the
         drooping-at-that-one-section issue is set aside - see the same
         note on right_wheel_rocker_joint below for the revolute version
         to restore once that's sorted. -->
    <joint name="left_wheel_rocker_joint" type="fixed">
        <parent link="base_link"/>
        <child link="left_rocker"/>
        <origin xyz="0 ${chassis_width/2+rocker_width/2} 0" rpy="0 0 ${pi/2}" />
    </joint>

    <link name="left_rocker">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 ${-pi/2}"/>
            <geometry>
                <box size="${rocker_length} ${rocker_width} 0.025"/>
            </geometry>
            <material name="blue"/>
        </visual>
        <collision>
            <origin xyz="${rocker_length/2} 0 ${rocker_height/2}"/>
            <geometry>
                <box size="${rocker_length} ${rocker_width} ${rocker_height}"/>
            </geometry>
        </collision>
        <xacro:inertial_box mass="${rocker_mass}" x="${rocker_length}" y="${rocker_width}" z="${rocker_height}">
            <origin xyz="${rocker_length/2} 0 ${rocker_height/2}" rpy="0 0 0"/>
        </xacro:inertial_box>
    </link>

    <joint name="tilted_joint" type="fixed">
        <parent link="left_rocker"/>
        <child link="tilted_link"/>
        <origin xyz="0 ${rocker_length/2} 0" rpy="${pi/4} 0 0" />
    </joint>

    <link name="tilted_link">
        <visual>
            <origin xyz="0 0 -${tilted_link/2}" rpy="0 ${pi/2} 0"/>
            <geometry>
                <box size="${tilted_link} ${rocker_width} 0.025"/>
            </geometry>
            <material name="black"/>
        </visual>
        <!-- Was a copy-paste of left_rocker's full 0.13x0.02x0.2 collision
             box, sitting at an offset that doesn't match this link's own
             (much smaller, 0.1x0.02x0.025) visual at all - a phantom
             collision volume trailing off of this strut. Now matches the
             visual exactly. -->
        <collision>
            <origin xyz="0 0 -${tilted_link/2}" rpy="0 ${pi/2} 0"/>
            <geometry>
                <box size="${tilted_link} ${rocker_width} 0.025"/>
            </geometry>
        </collision>
        <xacro:inertial_box mass="${rocker_mass}" x="${tilted_link}" y="${rocker_width}" z="0.025">
            <origin xyz="0 0 -${tilted_link/2}" rpy="0 ${pi/2} 0"/>
        </xacro:inertial_box>
    </link>

    <!-- Bogie pivot: TEMPORARILY fixed, see left_wheel_rocker_joint above. -->
    <joint name="left_bogie_joint" type="fixed">
        <parent link="left_rocker"/>
        <child link="left_bogie"/>
        <origin xyz="0 ${-rocker_length/2} 0" rpy="0 0 0" />
    </joint>

    <link name="left_bogie">
        <xacro:inertial_box mass="0.05" x="0.02" y="0.02" z="0.02">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_box>
    </link>

    <joint name="tilted_two_joint" type="fixed">
        <parent link="left_bogie"/>
        <child link="tilted_two_link"/>
        <origin xyz="0 0 0" rpy="${-pi/4} 0 0" />
    </joint>

    <link name="tilted_two_link">
        <visual>
            <origin xyz="0 0 -${tilted_link/2}" rpy="0 ${pi/2} 0"/>
            <geometry>
                <box size="${tilted_link} ${rocker_width} 0.025"/>
            </geometry>
            <material name="black"/>
        </visual>
        <collision>
            <origin xyz="0 0 -${tilted_link/2}" rpy="0 ${pi/2} 0"/>
            <geometry>
                <box size="${tilted_link} ${rocker_width} 0.025"/>
            </geometry>
        </collision>
        <xacro:inertial_box mass="${rocker_mass}" x="${tilted_link}" y="${rocker_width}" z="0.025">
            <origin xyz="0 0 -${tilted_link/2}" rpy="0 ${pi/2} 0"/>
        </xacro:inertial_box>
    </link>

    <joint name="left_wheel_one_joint" type="continuous">
        <parent link="tilted_two_link"/>
        <child link="left_wheel_one"/>
        <origin xyz="0 0 ${-tilted_link + 0.002}" rpy="0 ${pi/2} 0" />
        <axis xyz="0 0 1"/>
    </joint>

    <link name="left_wheel_one">
        <visual>
            <geometry>
                <cylinder radius="${wheel_radius}" length="${wheel_thickness}"/>
            </geometry>
            <material name="blue"/>
        </visual>
        <collision>
            <geometry>
                <sphere radius="${wheel_radius}"/>
            </geometry>
        </collision>
        <xacro:inertial_cylinder mass="${wheel_mass}" length="${wheel_thickness}" radius="${wheel_radius}">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_cylinder>
    </link>

    <gazebo reference="left_wheel_one">
        <material>Gazebo/Blue</material>
    </gazebo>

    <joint name="tilted_three_joint" type="fixed">
        <parent link="left_bogie"/>
        <child link="tilted_three_link"/>
        <origin xyz="0 0 0" rpy="${pi/4} 0 0" />
    </joint>

    <link name="tilted_three_link">
        <visual>
            <origin xyz="0 0 -${tilted_link/2}" rpy="0 ${pi/2} 0"/>
            <geometry>
                <box size="${tilted_link} ${rocker_width} 0.025"/>
            </geometry>
            <material name="black"/>
        </visual>
        <collision>
            <origin xyz="0 0 -${tilted_link/2}" rpy="0 ${pi/2} 0"/>
            <geometry>
                <box size="${tilted_link} ${rocker_width} 0.025"/>
            </geometry>
        </collision>
        <xacro:inertial_box mass="${rocker_mass}" x="${tilted_link}" y="${rocker_width}" z="0.025">
            <origin xyz="0 0 -${tilted_link/2}" rpy="0 ${pi/2} 0"/>
        </xacro:inertial_box>
    </link>

    <joint name="left_wheel_three_joint" type="continuous">
        <parent link="tilted_three_link"/>
        <child link="left_wheel_three"/>
        <origin xyz="0 0 ${-tilted_link + 0.002}" rpy="0 ${pi/2} 0" />
        <axis xyz="0 0 1"/>
    </joint>

    <link name="left_wheel_three">
        <visual>
            <geometry>
                <cylinder radius="${wheel_radius}" length="${wheel_thickness}"/>
            </geometry>
            <material name="blue"/>
        </visual>
        <collision>
            <geometry>
                <sphere radius="${wheel_radius}"/>
            </geometry>
        </collision>
        <xacro:inertial_cylinder mass="${wheel_mass}" length="${wheel_thickness}" radius="${wheel_radius}">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_cylinder>
    </link>

    <gazebo reference="left_wheel_three">
        <material>Gazebo/Blue</material>
    </gazebo>

    <joint name="left_wheel_two_joint" type="continuous">
        <parent link="tilted_link"/>
        <child link="left_wheel_two"/>
        <origin xyz="0 0 ${-tilted_link}" rpy="0 ${pi/2} 0" />
        <axis xyz="0 0 1"/>
    </joint>

    <link name="left_wheel_two">
        <visual>
            <geometry>
                <cylinder radius="${wheel_radius}" length="${wheel_thickness}"/>
            </geometry>
            <material name="blue"/>
        </visual>
        <collision>
            <geometry>
                <sphere radius="${wheel_radius}"/>
            </geometry>
        </collision>
        <xacro:inertial_cylinder mass="${wheel_mass}" length="${wheel_thickness}" radius="${wheel_radius}">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_cylinder>
    </link>

    <gazebo reference="left_wheel_two">
        <material>Gazebo/Blue</material>
        <!-- Was material-only, which meant this wheel fell back to
             isotropic default friction while the other 4 wheels have
             mu2: 0.1 for skidding. One high-lateral-friction wheel per
             side fighting four low-friction ones produces nonlinear,
             surface-dependent turning behavior that no EKF tuning can
             compensate for. Match the driven wheels' anisotropic setup. -->
        <mu1>0.6</mu1>
        <mu2>0.1</mu2>
        <fdir1>1 0 0</fdir1>
    </gazebo>

    <!-- TEMPORARILY fixed - all 4 suspension joints (left/right rocker +
         bogie) rigidified for now to rule out the suspension while
         chasing the droop-at-one-section bug. To restore full
         rocker-bogie articulation later, change type back to "revolute"
         on all 4 and put back:
           <axis xyz="1 0 0"/>
           <limit lower="-0.6" upper="0.6" effort="50" velocity="5"/>   (rocker joints)
           <limit lower="-0.4" upper="0.4" effort="50" velocity="5"/>   (bogie joints)
           <dynamics damping="2.0" friction="0.1"/>                    (rocker joints)
           <dynamics damping="1.0" friction="0.1"/>                    (bogie joints)
         Rigidifying does mean the fixed 3-wheels-per-side frame will
         fight ramp transitions again (see the wheel friction comment
         below) - fine for flat-floor testing, revisit before ramps. -->
    <joint name="right_wheel_rocker_joint" type="fixed">
        <parent link="base_link"/>
        <child link="right_rocker"/>
        <origin xyz="0 ${-chassis_width/2-rocker_width/2} 0" rpy="0 0 ${pi/2}" />
    </joint>

    <link name="right_rocker">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 ${-pi/2}"/>
            <geometry>
                <box size="${rocker_length} ${rocker_width} 0.025"/>
            </geometry>
            <material name="blue"/>
        </visual>
        <collision>
            <origin xyz="${rocker_length/2} 0 ${rocker_height/2}"/>
            <geometry>
                <box size="${rocker_length} ${rocker_width} ${rocker_height}"/>
            </geometry>
        </collision>
        <xacro:inertial_box mass="${rocker_mass}" x="${rocker_length}" y="${rocker_width}" z="${rocker_height}">
            <origin xyz="${rocker_length/2} 0 ${rocker_height/2}" rpy="0 0 0"/>
        </xacro:inertial_box>
    </link>

    <joint name="tilted_joint_two" type="fixed">
        <parent link="right_rocker"/>
        <child link="tilted_link_two"/>
        <origin xyz="0 ${rocker_length/2} 0" rpy="${pi/4} 0 0" />
    </joint>

    <link name="tilted_link_two">
        <visual>
            <origin xyz="0 0 -${tilted_link/2}" rpy="0 ${pi/2} 0"/>
            <geometry>
                <box size="${tilted_link} ${rocker_width} 0.025"/>
            </geometry>
            <material name="black"/>
        </visual>
        <collision>
            <origin xyz="0 0 -${tilted_link/2}" rpy="0 ${pi/2} 0"/>
            <geometry>
                <box size="${tilted_link} ${rocker_width} 0.025"/>
            </geometry>
        </collision>
        <xacro:inertial_box mass="${rocker_mass}" x="${tilted_link}" y="${rocker_width}" z="0.025">
            <origin xyz="0 0 -${tilted_link/2}" rpy="0 ${pi/2} 0"/>
        </xacro:inertial_box>
    </link>

    <joint name="right_bogie_joint" type="fixed">
        <parent link="right_rocker"/>
        <child link="right_bogie"/>
        <origin xyz="0 ${-rocker_length/2} 0" rpy="0 0 0" />
    </joint>

    <link name="right_bogie">
        <xacro:inertial_box mass="0.05" x="0.02" y="0.02" z="0.02">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_box>
    </link>

    <joint name="tilted_two_joint_two" type="fixed">
        <parent link="right_bogie"/>
        <child link="tilted_two_link_two"/>
        <origin xyz="0 0 0" rpy="${-pi/4} 0 0" />
    </joint>

    <link name="tilted_two_link_two">
        <visual>
            <origin xyz="0 0 -${tilted_link/2}" rpy="0 ${pi/2} 0"/>
            <geometry>
                <box size="${tilted_link} ${rocker_width} 0.025"/>
            </geometry>
            <material name="black"/>
        </visual>
        <collision>
            <origin xyz="0 0 -${tilted_link/2}" rpy="0 ${pi/2} 0"/>
            <geometry>
                <box size="${tilted_link} ${rocker_width} 0.025"/>
            </geometry>
        </collision>
        <xacro:inertial_box mass="${rocker_mass}" x="${tilted_link}" y="${rocker_width}" z="0.025">
            <origin xyz="0 0 -${tilted_link/2}" rpy="0 ${pi/2} 0"/>
        </xacro:inertial_box>
    </link>

    <joint name="right_wheel_one_joint" type="continuous">
        <parent link="tilted_two_link_two"/>
        <child link="right_wheel_one"/>
        <origin xyz="0 0 ${-tilted_link + 0.002}" rpy="0 ${pi/2} 0" />
        <axis xyz="0 0 1"/>
    </joint>

    <link name="right_wheel_one">
        <visual>
            <geometry>
                <cylinder radius="${wheel_radius}" length="${wheel_thickness}"/>
            </geometry>
            <material name="blue"/>
        </visual>
        <collision>
            <geometry>
                <sphere radius="${wheel_radius}"/>
            </geometry>
        </collision>
        <xacro:inertial_cylinder mass="${wheel_mass}" length="${wheel_thickness}" radius="${wheel_radius}">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_cylinder>
    </link>

    <gazebo reference="right_wheel_one">
        <material>Gazebo/Blue</material>
    </gazebo>

    <joint name="tilted_two_joint_three" type="fixed">
        <parent link="right_bogie"/>
        <child link="tilted_two_link_three"/>
        <origin xyz="0 0 0" rpy="${pi/4} 0 0" />
    </joint>
    
    <link name="tilted_two_link_three">
        <visual>
            <origin xyz="0 0 -${tilted_link/2}" rpy="0 ${pi/2} 0"/>
            <geometry>
                <box size="${tilted_link} ${rocker_width} 0.025"/>
            </geometry>
            <material name="black"/>
        </visual>
        <collision>
            <origin xyz="0 0 -${tilted_link/2}" rpy="0 ${pi/2} 0"/>
            <geometry>
                <box size="${tilted_link} ${rocker_width} 0.025"/>
            </geometry>
        </collision>
        <xacro:inertial_box mass="${rocker_mass}" x="${tilted_link}" y="${rocker_width}" z="0.025">
            <origin xyz="0 0 -${tilted_link/2}" rpy="0 ${pi/2} 0"/>
        </xacro:inertial_box>
    </link>

    <joint name="right_wheel_three_joint" type="continuous">
        <parent link="tilted_two_link_three"/>
        <child link="right_wheel_three"/>
        <origin xyz="0 0 ${-tilted_link + 0.002}" rpy="0 ${pi/2} 0" />
        <axis xyz="0 0 1"/>
    </joint>

    <link name="right_wheel_three">
        <visual>
            <geometry>
                <cylinder radius="${wheel_radius}" length="${wheel_thickness}"/>
            </geometry>
            <material name="blue"/>
        </visual>
        <collision>
            <geometry>
                <sphere radius="${wheel_radius}"/>
            </geometry>
        </collision>
        <xacro:inertial_cylinder mass="${wheel_mass}" length="${wheel_thickness}" radius="${wheel_radius}">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_cylinder>
    </link>

    <gazebo reference="right_wheel_three">
        <material>Gazebo/Blue</material>
    </gazebo>

    <joint name="right_wheel_two_joint" type="continuous">
        <parent link="tilted_link_two"/>
        <child link="right_wheel_two"/>
        <origin xyz="0 0 ${-tilted_link}" rpy="0 ${pi/2} 0" />
        <axis xyz="0 0 1"/>
    </joint>

    <link name="right_wheel_two">
        <visual>
            <geometry>
                <cylinder radius="${wheel_radius}" length="${wheel_thickness}"/>
            </geometry>
            <material name="blue"/>
        </visual>
        <collision>
            <geometry>
                <sphere radius="${wheel_radius}"/>
            </geometry>
        </collision>
        <xacro:inertial_cylinder mass="${wheel_mass}" length="${wheel_thickness}" radius="${wheel_radius}">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_cylinder>
    </link>

    <gazebo reference="right_wheel_two">
        <material>Gazebo/Blue</material>
        <mu1>0.6</mu1>
        <mu2>0.1</mu2>
        <fdir1>1 0 0</fdir1>
    </gazebo>

    <!-- Was 0.01 (near-frictionless) on all four passive wheels. That's
         fine on flat ground, but it means these wheels contribute zero
         holding force the instant the rigid (non-suspended) chassis
         pitches on a grade change and weight shifts onto them, which is
         exactly what a fixed 3-wheels-per-side frame does at a ramp
         transition. Raised to something closer to the driven wheels'
         (default, ~1.0) friction so the passive wheels can at least help
         hold position instead of letting the robot slide straight back
         down. Tune down again if this makes turning too draggy. -->
    <gazebo reference="left_wheel_one">
        <mu1>0.6</mu1>      <!-- along rolling direction: keep for climbing -->
        <mu2>0.1</mu2>      <!-- perpendicular/lateral: lower so it can skid to turn -->
        <fdir1>1 0 0</fdir1> <!-- vector defining the "mu1" direction -->
    </gazebo>
    <gazebo reference="left_wheel_three">
        <mu1>0.6</mu1>
        <mu2>0.1</mu2>
        <fdir1>1 0 0</fdir1>
    </gazebo>
    <gazebo reference="right_wheel_one">
        <mu1>0.6</mu1>
        <mu2>0.1</mu2>
        <fdir1>1 0 0</fdir1>
    </gazebo>
    <gazebo reference="right_wheel_three">
        <mu1>0.6</mu1>
        <mu2>0.1</mu2>
        <fdir1>1 0 0</fdir1>
    </gazebo>

</robot>