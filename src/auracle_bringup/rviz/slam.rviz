# RViz layout for SLAM / mapping only.
# __NS__ is replaced by slam_mapping.launch.py with "" or "/<namespace>", so the same file works
# in sim (no namespace) and on the real robot (namespace:=auracle). Don't open it directly with
# `rviz2 -d` unless you first replace __NS__ by hand.
#
# Deliberately NOT in here (they belong to navigation, not mapping): global/local costmap,
# global plan, AMCL particle cloud, 2D Pose Estimate and Nav2 Goal tools. This config does not
# load any saved map - the Map display only shows whatever slam_toolbox is publishing live on /map.
# To hide even that until you want it, set Enabled/Value to false on the "SLAM Map" display.
Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Value: true
      Cell Size: 1
      Plane Cell Count: 20
      Color: 90; 90; 90
    - Class: rviz_default_plugins/Map
      Name: SLAM Map
      Enabled: true
      Value: true
      Alpha: 1
      Color Scheme: map
      Draw Behind: true
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: __NS__/map
      Update Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: __NS__/map_updates
      Use Timestamp: false
    - Class: rviz_default_plugins/LaserScan
      Name: LaserScan
      Enabled: true
      Value: true
      Style: Flat Squares
      Size (m): 0.04
      Color Transformer: FlatColor
      Color: 255; 40; 40
      Decay Time: 0
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: __NS__/scan
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Value: true
      Alpha: 0.8
      Description Source: Topic
      Description Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: __NS__/robot_description
    - Class: rviz_default_plugins/MarkerArray
      Name: SLAM pose graph
      Enabled: false
      Value: false
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: __NS__/slam_toolbox/graph_visualization
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: false
      Value: false
      Show Names: false
      Show Axes: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 20
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/Measure
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Near Clip Distance: 0.01
      Scale: 80
      Invert Z Axis: false
      X: 0
      Y: 0
Window Geometry:
  Height: 900
  Width: 1400
